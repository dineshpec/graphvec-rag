# Copy this file to `.env` at the repo root and fill in real values.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS/Linux:           cp .env.example .env
#
# NEVER commit the real .env file or share it — it contains secrets.

# --- LLM / OpenAI (required) ---
# Your OpenAI API key. Required; startup fails without it.
OPENAI_API_KEY=sk-your-openai-key-here
# Chat/completion model used for answer generation.
OPENAI_MODEL=gpt-4o-mini
# Embedding model used to build/query the FAISS vector index.
EMBEDDING_MODEL=text-embedding-3-small

# --- Neo4j AuraDB (required) ---
# Connection URI, e.g. neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password-here
# Logical database name within the Neo4j instance.
NEO4J_DATABASE=neo4j

# --- Service ---
# Host/port the FastAPI backend binds to. Inside Docker use 0.0.0.0 so the
# container's published port is reachable; the app itself reads these only
# for local (non-Docker) runs since the Dockerfile CMD hardcodes host/port.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# development | staging | production
ENVIRONMENT=development
# Standard Python logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- Security ---
# If set (non-empty), required as the X-API-Key header on protected routes.
API_KEY=change-me-to-a-strong-random-value
# Comma-separated list of origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# slowapi rate limit strings, e.g. "20/minute".
RATE_LIMIT_QUERY=20/minute
RATE_LIMIT_UPLOAD=5/minute

# --- Ingestion / Retrieval tuning ---
# Character size of each text chunk during ingestion.
CHUNK_SIZE=1000
# Character overlap between consecutive chunks.
CHUNK_OVERLAP=200
# Number of nearest-neighbor vector chunks retrieved per query.
RETRIEVAL_K=3
# Max number of graph results returned per query.
GRAPH_RESULT_LIMIT=20
# Maximum accepted PDF upload size, in megabytes.
MAX_UPLOAD_MB=25

# --- Evals ---
# Advisory RAGAS-style scoring (retrieval relevance, faithfulness, answer
# relevance) computed after each successful answer. Never blocks or alters
# the response -- purely for observability via retrieval_metadata. Adds one
# extra LLM call per query; disable to save cost/latency in high-volume
# production if you don't need per-query quality scores.
ENABLE_EVALS=true
