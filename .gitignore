# --- Secrets: never commit real credentials ---
.env
*.env
!.env.example

# --- Python ---
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ---
venv/
**/venv/
.venv/
env/
ENV/

# --- Test / lint / type-check caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# --- Runtime / generated data artifacts ---
# These are created locally at ingestion/runtime and are environment-specific;
# they should not be committed. Folder structure is preserved via .gitkeep.
backend/faiss_index/*
!backend/faiss_index/.gitkeep
backend/doc_store.sqlite3
backend/temp_uploads/*
!backend/temp_uploads/.gitkeep

# --- Streamlit ---
.streamlit/secrets.toml

# --- Editor / OS cruft ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Node (defensive, not currently used) ---
node_modules/
